<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Android 12+ shows its own launch screen (app icon on a solid color)
         instead of windowBackground; use the brand orange so it runs straight
         into the Flutter splash. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">#F4782F</item>
    </style>
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">?android:colorBackground</item>
    </style>
</resources>
